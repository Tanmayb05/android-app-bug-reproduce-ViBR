# OpenAI API Configuration
OPENAI_API_KEY=sk-your-api-key-here

# Android SDK Configuration (Optional - auto-detected on most systems)
ANDROID_HOME=/path/to/android/sdk

# Device Configuration
# Default emulator ID; change if using a different device
DEVICE_ID=emulator-5554

# GroundingDINO Configuration
GROUNDING_DINO_WEIGHTS_PATH=./GroundingDINO/weights/groundingdino_swint_ogc.pth

# Model Selection
DINO_MODEL_NAME=swin_t  # Can be swin_t, swin_s, swin_b

# API Rate Limiting (Optional)
OPENAI_REQUEST_TIMEOUT=120
OPENAI_MAX_RETRIES=3
